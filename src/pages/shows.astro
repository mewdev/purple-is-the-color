---
import Layout from "../layouts/Layout.astro";
import { AstroSeo } from "@astrolib/seo";
import BandsInTown from "../components/BandsInTown.astro";
---

<AstroSeo
  title="Shows"
  titleTemplate="%s — Purple is the Color"
  description="Find upcoming concert dates for Purple is the Color. See where this Austrian-Czech jazz quartet will perform next and get your tickets now."
  canonical="https://www.purpleisthecolor.com/shows"
  openGraph={{
    url: "https://www.purpleisthecolor.com/shows",
    title: "%s — Purple is the Color",
    description:
      "Find upcoming concert dates for Purple is the Color. See where this Austrian-Czech jazz quartet will perform next and get your tickets now.",
    images: [
      {
        url: "https://www.example.ie/og-image-01.jpg",
        width: 800,
        height: 600,
        alt: "Og Image Alt",
        type: "image/jpeg",
      },
      {
        url: "https://www.example.ie/og-image-02.jpg",
        width: 900,
        height: 800,
        alt: "Og Image Alt Second",
        type: "image/jpeg",
      },
      { url: "https://www.example.ie/og-image-03.jpg" },
      { url: "https://www.example.ie/og-image-04.jpg" },
    ],
    site_name: "SiteName",
  }}
  twitter={{
    handle: "@handle",
    site: "@site",
    cardType: "summary_large_image",
  }}
/>
<Layout title="shows">
  <!-- PX-4 global! -->
  <section
    id="shows"
    class="flex flex-col h-full justify-end items-center px-4"
  >
    <BandsInTown />
  </section>
</Layout>
