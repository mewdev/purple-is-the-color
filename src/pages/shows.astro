---
import Layout from "../layouts/Layout.astro";
import { AstroSeo } from "@astrolib/seo";
---

<AstroSeo
  title="Shows"
  description="Shows"
  canonical="https://www.purpleisthecolor.com/shows"
  openGraph={{
    url: "https://www.url.ie/a",
    title: "Open Graph Title",
    description: "Open Graph Description",
    images: [
      {
        url: "https://www.example.ie/og-image-01.jpg",
        width: 800,
        height: 600,
        alt: "Og Image Alt",
        type: "image/jpeg",
      },
      {
        url: "https://www.example.ie/og-image-02.jpg",
        width: 900,
        height: 800,
        alt: "Og Image Alt Second",
        type: "image/jpeg",
      },
      { url: "https://www.example.ie/og-image-03.jpg" },
      { url: "https://www.example.ie/og-image-04.jpg" },
    ],
    site_name: "SiteName",
  }}
  twitter={{
    handle: "@handle",
    site: "@site",
    cardType: "summary_large_image",
  }}
/>
<Layout title="shows">
  <section id="shows" class="flex flex-col h-full justify-end items-end">
    <p
      class="font-inter font-extralight text-matteWhite uppercase md:text-3xl leading-none text-justify"
    >
      To be annouced
    </p>
  </section>
</Layout>
