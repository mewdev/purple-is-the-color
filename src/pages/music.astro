---
import Layout from '../layouts/Layout.astro';
import SquareImage from '../components/SquareImage.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
const allAlbums = await getCollection('albums');
const allVideos = await getCollection('videos');
---
<Layout title="music">
		<section id="shows" class="flex flex-col h-[95vh] justify-center">

			<div class="flex gap-2 overflow-x-auto max-w-screen">

			{allVideos.map(video => {
				return(
				<div class="relative w-60 h-56">
					<SquareImage>
						<img loading="lazy" class="grayscale w-full h-full absolute inset-0 object-cover" src={video.data.thumbnail} alt={video.data.title} />
					</SquareImage>
				</div>
				)
			})}

			</div>



		</section>
</Layout>



