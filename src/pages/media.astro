---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
const allAlbums = await getCollection('albums');
const allVideos = await getCollection('videos');
console.log(allAlbums)
---

<Layout title="media">
	<main>
		<div class="bg-white flex justify-center">media</div>
<div class="bg-red-300 flex items-center justify-center">
	{allAlbums.map((post) => (
		<div class="flex flex-col w-fit items-center justify-center">
			<Image class="w-1/2 h-1/2"src={post.data.cover} alt={post.data.title} />
			<h4 class="text-6xl font-bold">{post.data.title}<span class="font-thin">{post.data.year}</span></h4>
		</div>
	))}
</div>

<div class="bg-green-300">
	<h2>Videos</h2>
		{allVideos.map((post) => (
			<div>
				<h2 class="font-bold">{post.data.title}</h2>
				<h3>{post.body}</h3>
			</div>
		))}
	
	
	</div>

	</main>
</Layout>

