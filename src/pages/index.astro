---
import Layout from '../layouts/Layout.astro';
import { getImage, Image } from "astro:assets";
import myBackground from "../images/home_background_transparent.png";
const optimizedBackground = await getImage({src: myBackground, format: 'webp'});
---

<Layout title="index">
	<main class="overflow-hidden h-screen">
		<!-- // md and larger -->
		<section id="hero-section" class=" hidden md:flex flex-col h-screen justify-end bg-no-repeat bg-contain md:bg-contain bg-bottom" style={`background-image: url(${optimizedBackground.src}), linear-gradient(to top, black 40%, #97327D 85%);`}>
			<!-- <h1 class="text-white font-monumentBold text-justify text-7xl md:text-8xl lg:text-9xl leading-none uppercase">Purple is the Color</h1> -->

<!-- #97327D -->

			<h1 class="text-white font-monumentBold text-4xl md:text-8xl lg:text-9xl uppercase flex flex-col justify-between">
				<div class="flex justify-between">
				  <span>Purple</span>
				  <span>is</span>
				</div>
				<div class="flex justify-between">
				  <span>the</span>
				  <span>Color</span>
				</div>
			  </h1>

		</section>




		<!-- // sm and smaller -->
		<section id="hero-section" class="md:hidden flex flex-col h-screen justify-end" style={`background-image: linear-gradient(to top, black 40%, #97327D 85%);`}>
			<!-- <h1 class="text-white font-monumentBold text-justify text-7xl md:text-8xl lg:text-9xl leading-none uppercase">Purple is the Color</h1> -->

<!-- #97327D -->
<Image class="w-full h-full object-contain" src={optimizedBackground.src} alt="Purple is the Color" height={"1080"} width={"1920"} />
			<h1 class="text-white font-monumentBold text-5xl md:text-8xl lg:text-9xl uppercase flex flex-col justify-between">
				<div class="flex justify-between">
				  <span>Purple</span>
				  <span>is</span>
				</div>
				<div class="flex justify-between">
				  <span>the</span>
				  <span>Color</span>
				</div>
			  </h1>

		</section>






	</main>
</Layout>


