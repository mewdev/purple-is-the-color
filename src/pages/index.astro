---
import Layout from '../layouts/Layout.astro';
import { getImage } from "astro:assets";
import myBackground from "../images/home_background.jpg";

const optimizedBackground = await getImage({src: myBackground, format: 'webp'});
---

<Layout title="index">
	<main>
		<!-- Hero Section -->
		<section id="hero-section" class="bg-white flex justify-center h-screen items-end bg-cover bg-center" style={`background-image: url(${optimizedBackground.src});`}>
			<h1 class="text-white text-[10rem] leading-none tracking-tighter font-extrabold uppercase">Purple is the Color</h1>
		</section>
		<!-- Info Section -->
		<section id="info-section" class="bg-gray-400">
			<h2 class="font-bold text-5xl leading-none text-justify">⎯ an internationally acclaimed jazz quartet known for their bold, innovative sound and commitment to exploring the depths of musical expression without digital shortcuts.</h2>
			<a class="italic font-thin uppercase text-5xl"href="#">Read more</a>
		</section>
		<!-- Homepage Contact Section -->
		<section id="social-section" class="bg-gray-400 h-auto">
			<div class="flex flex-col justify-center">
				<span class="text-2xl font-bold">Instagram</span>
				<span class="text-2xl font-bold">Facebook</span>
				<span class="text-2xl font-bold">Youtube</span>
			</div>
		</section>
	</main>
	</main>
</Layout>



