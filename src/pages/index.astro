---
import Layout from '../layouts/Layout.astro';
import { getImage } from "astro:assets";
import myBackground from "../images/home_background.jpg";
const optimizedBackground = await getImage({src: myBackground, format: 'webp'});
---

<Layout title="index">
	<main>
		<section id="hero-section" class="flex flex-col h-screen justify-end bg-cover bg-bottom" style={`background-image: url(${optimizedBackground.src});`}>
			<h1 class="text-white font-monumentBold text-justify text-8xl md:text-9xl lg:text-10xl leading-none uppercase">Purple is the Color</h1>
		</section>
	</main>
</Layout>


