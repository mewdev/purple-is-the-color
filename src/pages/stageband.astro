---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { AstroSeo } from '@astrolib/seo';
import { Image } from 'astro:assets';
const allConcerts = await getCollection('stageband');

---
<AstroSeo
title="Stageband"
description="Stageband"
canonical="https://www.purpleisthecolor.com/"
openGraph={{
  url: 'https://www.url.ie/a',
  title: 'Open Graph Title',
  description: 'Open Graph Description',
  images: [
	{
	  url: 'https://www.example.ie/og-image-01.jpg',
	  width: 800,
	  height: 600,
	  alt: 'Og Image Alt',
	  type: 'image/jpeg',
	},
	{
	  url: 'https://www.example.ie/og-image-02.jpg',
	  width: 900,
	  height: 800,
	  alt: 'Og Image Alt Second',
	  type: 'image/jpeg',
	},
	{ url: 'https://www.example.ie/og-image-03.jpg' },
	{ url: 'https://www.example.ie/og-image-04.jpg' },
  ],
  site_name: 'SiteName',
}}
twitter={{
  handle: '@handle',
  site: '@site',
  cardType: 'summary_large_image',
}}
/>
<Layout title="stageband">
		<section id="stageband" class="flex flex-col h-full justify-end">
			<div class="flex flex-col flex-wrap gap-2">
				<span class="text-matteWhite uppercase md:text-3xl font-inter font-extralight">Oktober 2024 ⎯ Juni 2025</span>
				<span class="text-matteWhite uppercase md:text-3xl  font-inter font-extralight place-self-end">Porgy&Bess Riemergasse 11 1010 Wien</span>
				<span class="text-matteWhite uppercase md:text-3xl  font-inter font-extralight place-self-end">Tickets: <a href="mailto:ticket@porgy.at">ticket@porgy.at</a><a href="tel:+4315128811"></a></span>
				<span class="text-matteWhite uppercase md:text-3xl font-inter font-extralight"><a href="https://porgy.at">porgy.at</a></span>
			</div>
			<ul class="flex flex-col w-screen">

				{allConcerts.map(concert => {

					const date = new Date(concert.data.date);
					const month = date.toLocaleString('default', { month: 'long' });
					const day = date.toLocaleString('default', { day: 'numeric' });

					return(
					<li class="relative font-inter font-extralight text-3xl md:text-5xl text-matteWhite after:absolute after:bg-matteWhite after:h-0.5 after:w-0 after:bottom-0 after:left-0 hover:after:w-full after:transition-all after:duration-500 cursor-pointer">
					<a class="flex justify-between" href={concert.data.url} target="_blank">
					  <span>{day + "."}</span>
					  <span class="inline-block">{month}</span>
					</a>
				  </li>
					)
				})}

			</ul>
		</section>
</Layout>