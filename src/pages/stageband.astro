---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
const allConcerts = await getCollection('stageband');
---
<!-- 1. Link hover overflow glitch! -->
 <!-- 2. Shows styling! -->
  <!-- 3. Images on hover? -->
<Layout title="stageband">
		<section id="stageband" class="flex flex-col h-[100vh] justify-center">
			<ul class="flex flex-col w-screen">

				{allConcerts.map(concert => {

					const date = new Date(concert.data.date);
					const month = date.toLocaleString('default', { month: 'long' });
					const day = date.toLocaleString('default', { day: 'numeric' });

					return(
					<li class="relative font-extralight text-5xl text-white after:absolute after:bg-white after:h-0.5 after:w-0 after:bottom-0 after:left-0 hover:after:w-full after:transition-all after:duration-500 cursor-pointer">
					<a class="flex justify-between" href={concert.data.url} target="_blank">
					  <span>{day + "."}</span>
					  <span class="inline-block">{month}</span>
					</a>
				  </li>
					)
				})}

			</ul>
		</section>
</Layout>



