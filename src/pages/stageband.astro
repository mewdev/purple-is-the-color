---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
const allConcerts = await getCollection('stageband');
---
  <!-- 3. Images on hover? -->
<Layout title="stageband">
		<section id="stageband" class="flex flex-col h-full justify-center">
			<div class="flex w-screen gap-4 items-start">
				<span class="text-matteWhite text-xs md:text-base font-inter font-extralight flex-grow">Oktober 2024 ⎯ Juni 2025</span>
				<span class="text-matteWhite text-xs md:text-base  font-inter font-extralight flex-grow">Porgy&Bess Riemergasse 11 1010 Wien</span>
				<span class="text-matteWhite text-xs md:text-base  font-inter font-extralight">Tickets: <a href="mailto:ticket@porgy.at">ticket@porgy.at</a><a href="tel:+4315128811"></a></span>
				<span class="text-matteWhite text-xs md:text-base font-inter font-extralight"><a href="https://porgy.at">porgy.at</a></span>
			</div>
			<ul class="flex flex-col w-screen">

				{allConcerts.map(concert => {

					const date = new Date(concert.data.date);
					const month = date.toLocaleString('default', { month: 'long' });
					const day = date.toLocaleString('default', { day: 'numeric' });

					return(
					<li class="relative font-extralight text-5xl text-matteWhite after:absolute after:bg-matteWhite after:h-0.5 after:w-0 after:bottom-0 after:left-0 hover:after:w-full after:transition-all after:duration-500 cursor-pointer">
					<a class="flex justify-between" href={concert.data.url} target="_blank">
					  <span>{day + "."}</span>
					  <span class="inline-block">{month}</span>
					</a>
				  </li>
					)
				})}

			</ul>
		</section>
</Layout>



