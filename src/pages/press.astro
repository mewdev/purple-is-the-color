---
import Layout from "../layouts/Layout.astro";
import { AstroSeo } from "@astrolib/seo";
import image from "../images/pressPhoto.jpg";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
const pressCollection = await getCollection("press");
import { Modal } from "accessible-astro-components";
---

<AstroSeo
  title="Press"
  titleTemplate="%s — Purple is the Color"
  description="Get the latest press releases, reviews, and interviews about Purple is the Color."
  canonical="https://www.purpleisthecolor.com/press"
  openGraph={{
    url: "https://www.purpleisthecolor.com/press",
    title: "%s — Purple is the Color",
    description:
      "Get the latest press releases, reviews, and interviews about Purple is the Color. Media can contact us for press kits, photos, and interview requests.",
    images: [
      {
        url: "https://www.example.ie/og-image-01.jpg",
        width: 800,
        height: 600,
        alt: "Og Image Alt",
        type: "image/jpeg",
      },
      {
        url: "https://www.example.ie/og-image-02.jpg",
        width: 900,
        height: 800,
        alt: "Og Image Alt Second",
        type: "image/jpeg",
      },
      { url: "https://www.example.ie/og-image-03.jpg" },
      { url: "https://www.example.ie/og-image-04.jpg" },
    ],
    site_name: "SiteName",
  }}
  twitter={{
    handle: "@handle",
    site: "@site",
    cardType: "summary_large_image",
  }}
/>
<Layout>
  <!-- PX-4 global! -->
  <section id="shows" class="flex flex-col md:flex-row h-full justify-end px-4">
    <div class="w-full md:w-1/2 place-self-end">
      {
        pressCollection.map((item) => {
          const link = item.data.link;
          return (
            <ul class="flex">
              <li class="font-inter flex md:flex-col sd:items-center font-extralight text-3xl md:text-5xl text-matteWhite">
                <button
                  class="relative font-inter capitalize font-extralight text-3xl md:text-5xl text-matteWhite after:absolute after:bg-matteWhite after:h-0.5 after:w-0 after:bottom-0 after:left-0 hover:after:w-full after:transition-all after:duration-500 cursor-pointerr"
                  id={item.data.title}
                >
                  {item.data.title}
                </button>
                <div>
                  <Modal triggerId={item.data.title}>
                    {link.map((link) => {
                      return (
                        <ul>
                          <li class="font-inter text-base">
                            <a target="_blank" href={link.url}>
                              {link.name}
                            </a>
                          </li>
                        </ul>
                      );
                    })}
                  </Modal>
                </div>
              </li>
            </ul>
          );
        })
      }
    </div>

    <div class="w-full md:w-1/2 md:flex md:flex-col md:place-self-end">
      <Image
        src={image}
        height={1200}
        width={990}
        alt={"Photo of the band Purple is the Color"}
        class="object-cover w-full h-full grayscale"
      />
    </div>
  </section>
</Layout>
