---
import Layout from "../layouts/Layout.astro";
import { AstroSeo } from "@astrolib/seo";
import image from "../images/pressPhoto.jpg";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
const pressCollection = await getCollection("press");
import { Modal } from "accessible-astro-components";
---

<Layout>
  <section id="shows" class="flex flex-col md:flex-row h-full justify-end">
    <div class="w-full md:w-1/2 place-self-end">
      {
        pressCollection.map((item) => {
          const link = item.data.link;
          return (
            <ul class="flex">
              <li class="font-inter flex md:flex-col sd:items-center font-extralight text-3xl md:text-5xl text-matteWhite">
                <button
                  class="relative font-inter capitalize font-extralight text-3xl md:text-5xl text-matteWhite after:absolute after:bg-matteWhite after:h-0.5 after:w-0 after:bottom-0 after:left-0 hover:after:w-full after:transition-all after:duration-500 cursor-pointerr"
                  id={item.data.title}
                >
                  {item.data.title}
                </button>
                <div>
                  <Modal triggerId={item.data.title}>
                    {link.map((link) => {
                      return (
                        <a target="_blank" href={link.url}>
                          {link.name}
                        </a>
                      );
                    })}
                  </Modal>
                </div>
              </li>
            </ul>
          );
        })
      }
    </div>

    <div class="w-full md:w-1/2 md:flex md:flex-col md:place-self-end">
      <Image
        src={image}
        height={1200}
        width={990}
        alt={"Photo of the band Purple is the Color"}
        class="object-cover w-full h-full grayscale"
      />
    </div>
  </section>
</Layout>
