---
import Layout from "../layouts/Layout.astro";
import { AstroSeo } from "@astrolib/seo";
import image from "../images/pressPhoto.jpg";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
const pressCollection = await getCollection("press");
---

<Layout>
  <section id="shows" class="flex h-full justify-end">
    <div class="w-full md:w-1/2 place-self-end">
      {
        pressCollection.map((item) => {
          const link = item.data.link;
          return (
            <ul class="flex flex-col">
              <li class="font-inter font-extralight text-3xl md:text-5xl text-matteWhite">
                <span class="inline-block ml-auto mr-5 md:mr-10">
                  {item.data.title}
                </span>
                <div class="flex gap-2">
                  {link.map((link) => {
                    return (
                      <a
                        class="relative font-inter font-extralight italic text-xs md:text-xl text-matteWhite after:absolute after:bg-matteWhite after:h-0.5 after:w-0 after:bottom-0 after:left-0 hover:after:w-full after:transition-all after:duration-500 cursor-pointer"
                        href={link.url}
                      >
                        {link.name}
                      </a>
                    );
                  })}
                </div>
              </li>
            </ul>
          );
        })
      }
    </div>

    <div class="w-full md:w-1/2 md:flex md:flex-col md:place-self-end">
      <Image
        src={image}
        height={1200}
        width={990}
        alt={"Photo of the band Purple is the Color"}
        class="object-cover w-full h-full grayscale"
      />
    </div>
  </section>
</Layout>
