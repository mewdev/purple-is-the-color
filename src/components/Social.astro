---
const links = [
    {
        name: 'Ig',
        link: 'https://www.instagram.com/purple_Is_the_color_/'
    },
    {
        name: 'Fb',
        link: 'https://www.facebook.com/purpleisthecolor/'
    },
    {
        name: 'Yt',
        link: 'https://www.youtube.com/@purpleisthecolor1606'
    }
]
---
<ul class="flex gap-2">
    {links.map(item => <li class="relative uppercase text-3xl font-bold text-white after:absolute after:bg-white after:h-1 after:w-0 after:bottom-0 after:left-0 hover:after:w-full after:transition-all after:duration-500 cursor-pointer"><a target="_blank" href={item.link}>{item.name}</a></li>)}
</ul>