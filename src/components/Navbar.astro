---
const links = [
    { name: 'Stageband', href: '/stageband' },
    { name: 'About', href: '/about' },
    { name: 'Shows', href: '/shows' },
    { name: 'Media', href: '/media' },
    { name: 'Contact', href: '/contact' },
]
---
<nav>
    <ul class="flex gap-2">
        {links.map(item => <li class="relative uppercase text-4xl font-bold text-white after:absolute after:bg-white after:h-1 after:w-0 after:bottom-0 after:left-0 hover:after:w-full after:transition-all after:duration-500 cursor-pointer"><a target="_blank" href={item.link}>{item.name}</a></li>)}

    </ul>
</nav>