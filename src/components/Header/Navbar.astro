---
const links = [
    { name: 'Stageband', href: '/stageband' },
    { name: 'About', href: '/about' },
    { name: 'Shows', href: '/shows' },
    { name: 'Music', href: '/music' },
    { name: 'Press', href: '/press' },
]
---
<nav>
    <ul class="hidden md:flex md:gap-2">
        {links.map(item => <li class="relative uppercase text-2xl md:text-3xl font-extrabold text-matteWhite after:absolute after:bg-white after:h-0.5 after:w-0 after:bottom-0 after:left-0 hover:after:w-full after:transition-all after:duration-500 cursor-pointer"><a href={item.href}>{item.name}</a></li>)}
    </ul>
    <button id="toggle-menu" class="md:hidden z-40 font-inter relative uppercase text-2xl md:text-3xl font-bold text-matteWhite after:absolute after:bg-white after:h-0.5 after:w-0 after:bottom-0 after:left-0 hover:after:w-full after:transition-all after:duration-500 cursor-pointer">Menu</button>
</nav>