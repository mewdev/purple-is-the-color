---
const links = [
    { name: 'Stageband', href: '/stageband' },
    { name: 'About', href: '/about' },
    { name: 'Shows', href: '/shows' },
    { name: 'Music', href: '/music' },
    { name: 'Press', href: '/press' },
]
---
<label class="relative z-40 cursor-pointer px-3 py-6" for="mobile-menu">
    <input class="peer hidden" type="checkbox" id="mobile-menu" />

    <!-- "Menu" text shown by default -->
    <span class="relative z-50 block text-lg font-medium text-matteWhite transition-all duration-200 ease-out peer-checked:hidden">
        Menu
    </span>

    <!-- "Close" text shown when menu is open -->
    <span class="relative z-50 hidden text-lg font-medium text-matteWhite transition-all duration-200 ease-out peer-checked:block">
        Close
    </span>

    <!-- Overlay background when the menu is open -->
    <div class="fixed inset-0 z-40 hidden h-full w-full bg-matteBlack/80 backdrop-blur-sm peer-checked:block">
        &nbsp;
    </div>

    <!-- Menu content that fades in and out -->
    <div class="fixed top-0 right-0 z-40 h-full w-full overflow-y-auto transition-opacity duration-400 ease-in-out peer-checked:opacity-100 peer-checked:visible opacity-0 invisible">
        <div class="min-h-full w-[100%] bg-transparent px-6 pt-12">
            <menu>
                <ul class="flex flex-col md:hidden md:gap-2">
                    {links.map(item => (
                        <li class="relative uppercase text-2xl md:text-3xl font-extrabold text-matteWhite after:absolute after:bg-white after:h-0.5 after:w-0 after:bottom-0 after:left-0 hover:after:w-full after:transition-all after:duration-500 cursor-pointer">
                            <a href={item.href}>{item.name}</a>
                        </li>
                    ))}
                </ul>
            </menu>
        </div>
    </div>
</label>