---
import Sponsors from "./Sponsors.astro";

const currentYear = new Date().getFullYear();
---

<!-- PX-4 global! -->
<footer class="h-[5lvh] items-center flex justify-between w-screen px-4">
  <Sponsors />
  <span
    class="text-matteWhite z-10 font-inter uppercase text-xs font-extralight"
    >Photo by Maria Frodl</span
  >
  <span
    class="text-matteWhite z-10 font-inter uppercase text-xs font-extralight"
    >© {currentYear} All Rights Reserved</span
  >
</footer>
