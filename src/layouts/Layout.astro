---
import '../styles.css';
import '@fontsource-variable/inter';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ViewTransitions, fade } from 'astro:transitions';
import Background from '../components/Background.astro';
import Noise from '../components/Noise.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<ViewTransitions />
	</head>

	<body class="bg-matteBlack" transition:animate={fade({ duration: '1.5s'})}>
		<Background />
		<!-- <Noise /> -->
<!-- Layout -->
<div class="relative flex flex-col h-dvh justify-between w-screen">
	<Header />
	<main class="flex-grow">
		<slot />
	</main>
	<Footer />
</div>
	</body>
</html>

<script is:inline data-astro-rerun>

    document.addEventListener('astro:page-load',() => {
        const toggleMenu = document.getElementById('toggle-menu')
        const mobileMenu = document.getElementById('mobile-menu')
		const mobileLinks = document.querySelectorAll('.mobile-link')
		let menuOpen = false

		// Close mobile menu when a link is clicked
		mobileLinks.forEach(link => {
			link.addEventListener('click', () => {
				mobileMenu?.classList.add('hidden')
				toggleMenu.innerText = 'Menu'
				menuOpen = false
			})
		})

		// Menu toggle button functionality
        toggleMenu?.addEventListener('click', () => {
            if (menuOpen === false) {
				mobileMenu?.classList.remove('hidden')
                mobileMenu?.classList.add('fixed') 
                mobileMenu?.classList.add('flex')
                toggleMenu.innerText = 'Close'
				menuOpen = !menuOpen
            } else if (menuOpen === true) {
				mobileMenu?.classList.add('hidden')
                mobileMenu?.classList.remove('fixed') 
                mobileMenu?.classList.remove('flex')
                toggleMenu.innerText = 'Menu' 
				menuOpen = !menuOpen
            }
        })
    })
</script>